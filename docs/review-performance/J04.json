  "opening_benchmark_source": "#define _POSIX_C_SOURCE 200809L\n#include <stdio.h>\n#include <stdlib.h>\n#include <time.h>\n#include <sys/resource.h>\n#include \"mus_text_strategy.h\"\nint main(int argc, char **argv) {\n    if (argc != 4) return 2;\n    const size_t iterations = (size_t)strtoull(argv[3], NULL, 10);\n    struct timespec start, end;\n    if (clock_gettime(CLOCK_MONOTONIC, &start) != 0) return 1;\n    for (size_t i = 0; i < 200000; ++i) {\n        MusTextStrategy *strategy = NULL;\n        Status status = mus_text_strategy_open_schema(argv[1], argv[2], iterations, &strategy);\n        if (status != CFR_STATUS_SUCCESS) return 1;\n        mus_text_strategy_close(strategy);\n    }\n    if (clock_gettime(CLOCK_MONOTONIC, &end) != 0) return 1;\n    struct rusage usage;\n    if (getrusage(RUSAGE_SELF, &usage) != 0) return 1;\n    double seconds = (double)(end.tv_sec - start.tv_sec) + (double)(end.tv_nsec - start.tv_nsec) / 1e9;\n    printf(\"{\\\"opens\\\":200000,\\\"seconds\\\":%.9f,\\\"peak_rss_kib\\\":%ld}\\n\", seconds, usage.ru_maxrss);\n    return 0;\n}\n",
