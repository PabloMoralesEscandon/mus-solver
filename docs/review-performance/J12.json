  "launcher_source": "#define _GNU_SOURCE\n#include <spawn.h>\n#include <stdio.h>\n#include <sys/wait.h>\n#include <sys/resource.h>\n#include <errno.h>\nextern char **environ;\nint main(int argc, char **argv) {\n    if (argc < 3) return 2;\n    pid_t pid;\n    if (posix_spawn(&pid, argv[2], NULL, NULL, argv + 2, environ) != 0) return 3;\n    int status; struct rusage usage;\n    while (wait4(pid, &status, 0, &usage) < 0) if (errno != EINTR) return 4;\n    FILE *output = fopen(argv[1], \"w\");\n    if (!output) return 5;\n    if (fprintf(output, \"%ld\\n\", usage.ru_maxrss) < 0 || fclose(output)) return 6;\n    return WIFEXITED(status) ? WEXITSTATUS(status) : 128 + WTERMSIG(status);\n}\n",
  "launcher_build": "cc -O2 -Wall -Wextra -Werror /tmp/mus-review-j12-measure.c -o /tmp/mus-review-j12-measure",
  "script": "import hashlib,json,os,statistics,subprocess,tempfile,time\nfrom pathlib import Path\nos.sched_setaffinity(0,{0})\nroot=Path('build/review-j12-performance-inputs').resolve();root.mkdir(exist_ok=True)\nparent=Path('build/review-j11/release').resolve();candidate=Path('build/review-j12/release').resolve()\noutput=Path('/tmp/mus-review-j12-performance.json')\ndata={'parent_commit':'d80d01b','method':'Existing solver, bot, and library must remain byte-identical. New match evaluator has no parent executable; measure its absolute throughput and RSS, not a before/after algorithm speedup. Three repetitions of 1000 matches, CPU0, small fresh C launcher wait4 child peak RSS (avoids the Python launcher peak), no concurrent own build/test work. Fixed policy fixtures use 500 MCCFR iterations, seed7. Win counts demonstrate operation only; they are not evidence of competitive strength. Wall includes loading and JSON; game_seconds excludes these. TXT v1 can differ from raw on zero-mass nodes (J13 pending).','hashes':{},'inputs':{},'runs':[],'summary':[]}\nfor name in ['mus-solver','mus-bot','libmus_solver.a']:\n hashes=[hashlib.sha256((directory/name).read_bytes()).hexdigest() for directory in [parent,candidate]]\n assert hashes[0]==hashes[1],(name,hashes)\n data['hashes'][name]={'parent':hashes[0],'candidate':hashes[1],'equal':True}\nsolver=str(candidate/'mus-solver');ev=str(candidate/'mus-match-eval')\ndef prepare(command):\n if Path(command[-1]).exists(): return\n p=subprocess.run(command,capture_output=True,text=True);assert p.returncode==0,(command,p.stderr)\nfor variant in ['ordago','ordago-public']:\n prepare([solver,'--format',variant,'--iterations','500','--seed','7','--save',str(root/f'{variant}.cfr'),'--export-strategy',str(root/f'{variant}.txt')])\ntable=root/'scores'\nprepare([solver,'--format','ordago-score','--score-region','39:39','--iterations','500','--evaluation-samples','1000','--seed','7','--continuation',str(table),'--export-strategy',str(table/'score-39-39.txt')])\nfor p in root.rglob('*'):\n if p.is_file() and p.name not in ['training.lock','recovery.txt','last-rss.txt']:\n  data['inputs'][str(p.relative_to(root))]={'bytes':p.stat().st_size,'sha256':hashlib.file_digest(p.open('rb'),'sha256').hexdigest()}\ndef save():\n data['launcher_source']=Path('/tmp/mus-review-j12-measure.c').read_text();data['launcher_build']='cc -O2 -Wall -Wextra -Werror /tmp/mus-review-j12-measure.c -o /tmp/mus-review-j12-measure';data['script']=Path(__file__).read_text();output.write_text(json.dumps(data,indent=2)+'\\n')\ncases=[]\nfor variant in ['ordago','ordago-public']:\n for mode,suffix in [('--load-a','cfr'),('--strategy-a','txt')]:\n  cases.append((f'{variant}-{suffix}-three-0', [mode,str(root/f'{variant}.{suffix}'),'--opponent','three','--score','0:0']))\ncases.append(('public-raw-self-35',['--load-a',str(root/'ordago-public.cfr'),'--load-b',str(root/'ordago-public.cfr'),'--score','35:35']))\ncases.append(('hybrid-three-39',['--strategy-a',str(root/'ordago-public.txt'),'--score-table-a',str(table/'values.txt'),'--score-strategies-a',str(table),'--opponent','three','--score','39:39']))\nfor name,args in cases:\n reference=None\n for repeat in range(1,4):\n  command=[ev,*args,'--matches','1000','--seed','7']\n  with tempfile.TemporaryFile(mode='w+') as out,tempfile.TemporaryFile(mode='w+') as err:\n   rss_path=root/'last-rss.txt'\n   timed=['/tmp/mus-review-j12-measure',str(rss_path),*command]\n   start=time.perf_counter()\n   pid=os.posix_spawn(timed[0],timed,os.environ,file_actions=[(os.POSIX_SPAWN_DUP2,out.fileno(),1),(os.POSIX_SPAWN_DUP2,err.fileno(),2)])\n   _,status,usage=os.wait4(pid,0);wall=time.perf_counter()-start\n   out.seek(0);err.seek(0);stdout=out.read();stderr=err.read();assert status==0,(name,status,stderr)\n  result=json.loads(stdout);game_seconds=result.pop('seconds')\n  if reference is None:reference=result\n  assert reference==result\n  row={'case':name,'repeat':repeat,'command':command,'wall_seconds':wall,'game_seconds':game_seconds,'peak_rss_kib':int(rss_path.read_text().strip()),'result_sha256':hashlib.sha256(json.dumps(result,sort_keys=True,separators=(',',':')).encode()).hexdigest()}\n  data['runs'].append(row);save();print(name,repeat,wall,game_seconds,row['peak_rss_kib'],flush=True)\n rows=[r for r in data['runs'] if r['case']==name]\n summary={'case':name,**{key:statistics.median(r[key] for r in rows) for key in ['wall_seconds','game_seconds','peak_rss_kib']},'matches':reference['matches'],'hands':reference['hands'],'decisions':reference['decisions'],'wins':reference['wins']}\n summary['decisions_per_game_second']=sum(reference['decisions'])/summary['game_seconds']\n summary['methods_a']={}\n for row in reference['coverage']:\n  if row['dimension']=='phase' and row['policy']==0:summary['methods_a'][row['method']]=summary['methods_a'].get(row['method'],0)+row['count']\n data['summary'].append(summary);save();print(summary,flush=True)\ndata['existing_training_artifacts_unchanged']=True;save()\n",
  "existing_training_artifacts_unchanged": true,
  "postprocessing": "After measurement, each repeated full CLI result was replaced with result_sha256 = SHA256(json.dumps(result, sort_keys=True, separators=(comma, colon)).encode()). All time/RSS samples, commands, fixture hashes and summary counts are unchanged. The embedded script is the compact-output reproduction version, updated after the run; the executed runner stored result directly instead of result_sha256."
