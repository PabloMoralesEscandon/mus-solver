diff --git a/tests/test_score_scheduler.c b/tests/test_score_scheduler.c
new file mode 100644
index 0000000..f984420
--- /dev/null
+++ b/tests/test_score_scheduler.c
@@ -0,0 +1,172 @@
+#define _POSIX_C_SOURCE 200809L
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <time.h>
+
+/* Inject creation failures without changing the production API. */
+static int fail_after = -1, creation_calls;
+static int create_test_thread(pthread_t *thread, const pthread_attr_t *attributes,
+                              void *(*entry)(void *), void *context) {
+    if (fail_after >= 0 && creation_calls++ >= fail_after)
+        return EAGAIN;
+    return pthread_create(thread, attributes, entry, context);
+}
+#define pthread_create create_test_thread
+#include "../src/mus_score.c"
+#undef pthread_create
+#include "cfr/checkpoint.h"
+
+static int failures;
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #x); ++failures; } } while (0)
+
+typedef struct {
+    pthread_mutex_t mutex;
+    pthread_cond_t condition;
+    bool entered[5];
+    size_t active, peak, starts;
+    bool overlap;
+} Schedule;
+
+static Status record_start(const MusScoreGame *game, MusScoreCell *cell, void *raw) {
+    Schedule *schedule = raw;
+    const unsigned int a = game->initial_scores[0], b = game->initial_scores[1];
+    pthread_mutex_lock(&schedule->mutex);
+    schedule->entered[a] = true;
+    ++schedule->active;
+    ++schedule->starts;
+    if (schedule->active > schedule->peak) schedule->peak = schedule->active;
+    pthread_cond_broadcast(&schedule->condition);
+    Status status = CFR_STATUS_NOT_FOUND;
+    if (schedule->overlap) {
+        struct timespec deadline;
+        clock_gettime(CLOCK_REALTIME, &deadline);
+        deadline.tv_sec += 5;
+        /* Cell 0 waits until cell 1 starts. Cell 1 then waits for cell 2.
+         * A barrier across the first pair would prevent cell 2 from starting. */
+        const unsigned int dependency = a == 0 ? 1 : 2;
+        while (a < 2 && !schedule->entered[dependency]) {
+            if (pthread_cond_timedwait(&schedule->condition, &schedule->mutex,
+                                       &deadline) != 0) {
+                status = CFR_STATUS_IO_ERROR;
+                break;
+            }
+        }
+        if (status != CFR_STATUS_IO_ERROR) {
+            *cell = (MusScoreCell){.ready = true, .value = (double)a / 5,
+                .iterations = 2, .evaluation_samples = 10,
+                .training_seed = 7 + (uint64_t)a * MUS_ORDAGO_WAGER + b};
+            status = CFR_STATUS_SUCCESS;
+        }
+    }
+    --schedule->active;
+    pthread_mutex_unlock(&schedule->mutex);
+    return status;
+}
+
+static void initialize_diagonal(MusScoreTable *table) {
+    CHECK(mus_score_table_init(table, 5) == CFR_STATUS_SUCCESS);
+    for (unsigned int a = 0; a < 5; ++a)
+        for (unsigned int b = 0; b < 5; ++b)
+            if (a + b > 4)
+                table->cells[a][b] = (MusScoreCell){.ready = true,
+                    .value = ((double)a - b) / 5, .iterations = 2,
+                    .evaluation_samples = 10, .training_seed = 7};
+}
+
+static Status fail_second_save(const MusScoreGame *game, const Trainer *trainer,
+                               const MusScoreCell *cell, void *context) {
+    (void)trainer; (void)cell;
+    size_t *calls = context;
+    CHECK(game->initial_scores[0] == *calls);
+    return ++*calls == 2 ? CFR_STATUS_IO_ERROR : CFR_STATUS_SUCCESS;
+}
+
+static void test_overlap_and_failure(void) {
+    MusScoreTable table;
+    Schedule schedule = {.mutex = PTHREAD_MUTEX_INITIALIZER,
+        .condition = PTHREAD_COND_INITIALIZER, .overlap = true};
+    MusScoreTrainingOptions options = {.iterations = 2, .evaluation_samples = 10,
+        .seed = 7, .threads = 2, .recover_cell = record_start,
+        .recovery_context = &schedule};
+    initialize_diagonal(&table);
+    CHECK(mus_score_train(&table, 4, &options, NULL, NULL, NULL) == CFR_STATUS_SUCCESS);
+    CHECK(schedule.starts == 5 && schedule.peak == 2 && schedule.active == 0);
+    for (unsigned int a = 0; a < 5; ++a)
+        CHECK(table.cells[a][4-a].ready);
+    schedule.overlap = false;
+    schedule.starts = schedule.peak = 0;
+    initialize_diagonal(&table);
+    size_t saves = 0;
+    CHECK(mus_score_train(&table, 4, &options, fail_second_save, NULL, &saves) == CFR_STATUS_IO_ERROR);
+    /* Only the initial pair and the replacement for cell 0 may start.
+     * Every started worker must have returned before the API returns. */
+    CHECK(saves == 2 && schedule.starts == 3 && schedule.active == 0);
+    for (unsigned int a = 0; a < 5; ++a)
+        CHECK(!table.cells[a][4-a].ready);
+    pthread_cond_destroy(&schedule.condition);
+    pthread_mutex_destroy(&schedule.mutex);
+}
+
+typedef struct {
+    uint64_t hashes[3][3];
+    bool compare;
+    size_t saves;
+    pthread_t caller;
+} Saved;
+
+static Status save_hash(const MusScoreGame *game, const Trainer *trainer,
+                         const MusScoreCell *cell, void *context) {
+    (void)cell;
+    Saved *saved = context;
+    CHECK(pthread_equal(pthread_self(), saved->caller));
+    FILE *file = tmpfile();
+    if (!file) return CFR_STATUS_IO_ERROR;
+    Status status = cfr_checkpoint_write(file, trainer);
+    if (fseek(file, 0, SEEK_SET) != 0) status = CFR_STATUS_IO_ERROR;
+    uint64_t hash = UINT64_C(14695981039346656037);
+    int byte;
+    while ((byte = fgetc(file)) != EOF)
+        hash = (hash ^ (unsigned int)byte) * UINT64_C(1099511628211);
+    if (ferror(file)) status = CFR_STATUS_IO_ERROR;
+    if (fclose(file) != 0) status = CFR_STATUS_IO_ERROR;
+    unsigned int a = game->initial_scores[0], b = game->initial_scores[1];
+    if (saved->compare) CHECK(saved->hashes[a][b] == hash);
+    else saved->hashes[a][b] = hash;
+    ++saved->saves;
+    return status;
+}
+
+static void test_creation_fallback(void) {
+    MusScoreTable reference, actual;
+    MusScoreTrainingOptions options = {.iterations = 2, .evaluation_samples = 10, .seed = 7};
+    Saved saved = {.caller = pthread_self()};
+    CHECK(mus_score_table_init(&reference, 3) == CFR_STATUS_SUCCESS);
+    CHECK(mus_score_train(&reference, 0, &options, save_hash, NULL, &saved) == CFR_STATUS_SUCCESS);
+    CHECK(saved.saves == 9);
+    saved.compare = true;
+    options.threads = 3;
+    for (int failure = 0; failure < 3; ++failure) {
+        fail_after = failure;
+        creation_calls = 0;
+        saved.saves = 0;
+        CHECK(mus_score_table_init(&actual, 3) == CFR_STATUS_SUCCESS);
+        CHECK(mus_score_train(&actual, 0, &options, save_hash, NULL, &saved) == CFR_STATUS_SUCCESS);
+        CHECK(saved.saves == 9 && creation_calls > failure);
+        for (unsigned int a = 0; a < 3; ++a)
+            for (unsigned int b = 0; b < 3; ++b) {
+                CHECK(actual.cells[a][b].ready);
+                CHECK(actual.cells[a][b].value == reference.cells[a][b].value);
+                CHECK(actual.cells[a][b].sample_variance == reference.cells[a][b].sample_variance);
+            }
+    }
+    fail_after = -1;
+}
+
+int main(void) {
+    test_overlap_and_failure();
+    test_creation_fallback();
+    if (!failures) puts("Score scheduler checks passed.");
+    return failures ? 1 : 0;
+}
diff --git a/tests/test_score_scheduler_cli.py b/tests/test_score_scheduler_cli.py
new file mode 100644
index 0000000..82c5a5c
--- /dev/null
+++ b/tests/test_score_scheduler_cli.py
@@ -0,0 +1,48 @@
+"""Keep complete output records while saves overlap worker reports."""
+import re
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+binary = str(Path(sys.argv[1]).resolve())
+number = r"(?:unknown|[-+0-9.e]+)"
+statistics = (rf" uncertainty=local-sampling sample_variance={number}"
+              rf" standard_error={number} win_probability_se={number}")
+adaptive = (r" sampling=adaptive min_samples=2 max_samples=20 target_se=0.5"
+            r" stop=(?:estimated-target|sample-limit)")
+cell = re.compile(r"score-cell score=\d+:\d+ target=40 iterations=\d+"
+                  rf" evaluation_samples=\d+ value={number} win_probability={number}"
+                  + statistics + adaptive)
+report = re.compile(r"score-report score=\d+:\d+ iterations=\d+ information_sets=\d+"
+                    r" imported_nodes=\d+ imported_later_nodes=\d+ missing_source_nodes=\d+"
+                    r" existing_nodes=\d+ added_iterations=\d+")
+summary = re.compile(rf"score-table score=35:35 target=40 value={number} win_probability={number}"
+                     + statistics)
+extension = re.compile(r"score-extend score=\d+:\d+ initial_iterations=40 added_iterations=40"
+                       r" source_schema=\S+ continuation=updated-by-diagonal")
+
+
+def run(destination, source=None):
+    command = [binary, '--format', 'ordago-score', '--score', '35:35',
+               '--iterations', '40', '--evaluation-samples', '20',
+               '--evaluation-min-samples', '2', '--evaluation-target-se', '0.5',
+               '--threads', '4', '--report-every', '1', '--continuation', str(destination)]
+    command += ['--extend-continuation', str(source)] if source else ['--seed', '7']
+    result = subprocess.run(command, capture_output=True, text=True, timeout=60)
+    assert result.returncode == 0, result.stderr
+    lines = result.stdout.splitlines()
+    for line in lines:
+        assert any(pattern.fullmatch(line) for pattern in (cell, report, summary, extension)), line
+    assert sum(bool(cell.fullmatch(line)) for line in lines) == 45
+    assert sum(bool(report.fullmatch(line)) for line in lines) == 45 * 40
+    assert sum(bool(summary.fullmatch(line)) for line in lines) == 1
+    assert sum(bool(extension.fullmatch(line)) for line in lines) == (45 if source else 0)
+
+
+with tempfile.TemporaryDirectory(prefix='mus-score-scheduler-') as temporary:
+    root = Path(temporary)
+    for repeat in range(3):
+        run(root / str(repeat))
+    run(root / 'extended', root / '0')
+print('Concurrent score output checks passed.')
