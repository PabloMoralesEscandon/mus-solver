+static Status synchronize_parent_directory(const char *path) {
+    char *parent = strdup(path);
+    if (parent == NULL)
+        return CFR_STATUS_OUT_OF_MEMORY;
+    size_t length = strlen(parent);
+    while (length > 1 && parent[length - 1] == '/') parent[--length] = '\0';
+    char *separator = strrchr(parent, '/');
+    if (separator != NULL) separator[separator == parent ? 1 : 0] = '\0';
+    const int descriptor = open(separator == NULL ? "." : parent,
+                                O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    free(parent);
+    if (descriptor < 0)
+        return CFR_STATUS_IO_ERROR;
+    Status status = fsync(descriptor) == 0 ? CFR_STATUS_SUCCESS : CFR_STATUS_IO_ERROR;
+    if (close(descriptor) != 0) status = CFR_STATUS_IO_ERROR;
+    return status;
+}
+
+/* Confirm file data before publishing its name, then confirm the directory.
+ * A directory-sync error after rename can leave the new file visible. */
+static Status publish_file(FILE *stream, Status status,
+                           const char *temporary, const char *path) {
+    if (status == CFR_STATUS_SUCCESS && (fflush(stream) != 0 || fsync(fileno(stream)) != 0))
+        status = CFR_STATUS_IO_ERROR;
+    if (fclose(stream) != 0) status = CFR_STATUS_IO_ERROR;
+    if (status == CFR_STATUS_SUCCESS && rename(temporary, path) != 0)
+        status = CFR_STATUS_IO_ERROR;
+    if (status == CFR_STATUS_SUCCESS)
+        status = synchronize_parent_directory(path);
+    if (status != CFR_STATUS_SUCCESS) (void)remove(temporary);
+    return status;
+}
+
