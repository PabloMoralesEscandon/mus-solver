diff --git a/tests/persistence_trace.c b/tests/persistence_trace.c
new file mode 100644
index 0000000..3ca987e
--- /dev/null
+++ b/tests/persistence_trace.c
@@ -0,0 +1,54 @@
+#define _POSIX_C_SOURCE 200809L
+#include <errno.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+/* Linked only into the persistence test CLI through --wrap. Production calls
+ * the real system functions directly. Failure modes are selected per process. */
+int __real_fsync(int descriptor);
+int __real_rename(const char *old_path, const char *new_path);
+static bool renamed;
+
+static void record(const char *operation, const char *first, const char *second) {
+    const char *path = getenv("MUS_SYNC_TRACE");
+    if (path == NULL) return;
+    FILE *stream = fopen(path, "a");
+    if (stream == NULL) abort();
+    if (fprintf(stream, "%s\t%s\t%s\n", operation, first, second == NULL ? "" : second) < 0 ||
+        fclose(stream) != 0) abort();
+}
+
+int __wrap_fsync(int descriptor) {
+    char link[64], path[PATH_MAX];
+    (void)snprintf(link, sizeof(link), "/proc/self/fd/%d", descriptor);
+    const ssize_t count = readlink(link, path, sizeof(path) - 1);
+    if (count < 0) abort();
+    path[count] = '\0';
+    struct stat attributes;
+    if (fstat(descriptor, &attributes) != 0) abort();
+    const bool directory = S_ISDIR(attributes.st_mode);
+    const char *mode = getenv("MUS_SYNC_FAIL");
+    const bool fail = mode != NULL &&
+        ((!strcmp(mode, "file") && !directory) ||
+         (!strcmp(mode, "new-directory") && directory && !renamed) ||
+         (!strcmp(mode, "values") && strstr(path, "/values.txt.tmp") != NULL) ||
+         (!strcmp(mode, "extension") && strstr(path, "/extension.txt.tmp") != NULL) ||
+         (!strcmp(mode, "directory-after-rename") && directory && renamed));
+    record(fail ? "FAIL" : directory ? "DIR" : "FILE", path, NULL);
+    if (fail) { errno = EIO; return -1; }
+    return __real_fsync(descriptor);
+}
+
+int __wrap_rename(const char *old_path, const char *new_path) {
+    const int result = __real_rename(old_path, new_path);
+    if (result == 0) {
+        renamed = true;
+        record("RENAME", old_path, new_path);
+    }
+    return result;
+}
diff --git a/tests/test_persistence.py b/tests/test_persistence.py
new file mode 100644
index 0000000..621830e
--- /dev/null
+++ b/tests/test_persistence.py
@@ -0,0 +1,105 @@
+"""Check publication order and injected synchronization failures, not power loss."""
+import hashlib
+import os
+import pathlib
+import subprocess
+import sys
+import tempfile
+
+solver = str(pathlib.Path(sys.argv[1]).resolve())
+
+def digest(path): return hashlib.sha256(path.read_bytes()).hexdigest()
+
+with tempfile.TemporaryDirectory(prefix='mus-persistence-tests-') as tmp:
+    root = pathlib.Path(tmp)
+    trace = root/'trace.txt'
+
+    def run(args, failure=None, success=True, cwd=None):
+        trace.write_text('')
+        env = os.environ.copy(); env['MUS_SYNC_TRACE'] = str(trace)
+        env.pop('MUS_SYNC_FAIL', None)
+        if failure: env['MUS_SYNC_FAIL'] = failure
+        p = subprocess.run([solver,*args], input='',text=True,capture_output=True,
+                           env=env,cwd=cwd,timeout=20)
+        assert (p.returncode==0)==success, (args,p.returncode,p.stderr)
+        events = [line.split('\t') for line in trace.read_text().splitlines()]
+        if failure: assert any(e[0]=='FAIL' for e in events), events
+        return events
+
+    def generic(path, iterations=1):
+        return ['--format','single-bet','--iterations',str(iterations),'--seed','7','--save',str(path)]
+
+    def score(path, position='2:2', extension=None):
+        args = ['--format','ordago-score','--target','3','--score',position,
+                '--iterations','1','--evaluation-samples','1','--continuation',str(path)]
+        return args+(['--seed','7'] if extension is None else ['--extend-continuation',str(extension)])
+
+    def ordered(events):
+        for i,event in enumerate(events):
+            if event[0]!='RENAME': continue
+            assert i>0 and events[i-1][:2]==['FILE',str((root/pathlib.Path(event[1])).resolve())], events
+            assert i+1<len(events) and events[i+1][:2]==['DIR',str((root/pathlib.Path(event[2])).resolve().parent)], events
+
+    # A relative filename synchronizes '.', after synchronizing the full data.
+    checkpoint = root/'checkpoint.cfr'
+    events = run(generic('checkpoint.cfr'), cwd=root); ordered(events)
+    assert [e[0] for e in events]==['FILE','RENAME','DIR'], events
+    original = digest(checkpoint)
+    events = run(generic(checkpoint,2), failure='file', success=False)
+    assert digest(checkpoint)==original and not list(root.glob('checkpoint.cfr.tmp.*'))
+    assert not any(e[0]=='RENAME' for e in events)
+
+    compressed = root/'compressed.cfr.zst'
+    args = generic(compressed)
+    args[args.index('--save')] = '--save-compressed'
+    events = run(args); ordered(events)
+    compressed_hash = digest(compressed)
+    args[args.index('--iterations')+1] = '2'
+    run(args, failure='file', success=False)
+    assert digest(compressed)==compressed_hash
+    assert not list(root.glob('compressed.cfr.zst.tmp.*'))
+
+    # New directories, including a trailing slash, are persisted in their parent.
+    table = root/'table with spaces'
+    events = run(score(str(table)+'/'), failure='new-directory', success=False)
+    assert table.is_dir() and not list(table.iterdir())
+    assert events==[['FAIL',str(root),'']], events
+    # Retry must confirm the existing directory entry left by that failure.
+    events = run(score(str(table)+'/')); ordered(events)
+    assert events[0][:2]==['DIR',str(root)], events
+    renamed = [pathlib.Path(e[2]).name for e in events if e[0]=='RENAME']
+    assert renamed==['score-02-02.cfr.zst','values.txt'], renamed
+
+    # A table-sync failure keeps the previous published diagonal, even though
+    # new cell checkpoints have already been synchronized and renamed.
+    old_values = digest(table/'values.txt')
+    events = run(score(table,'1:1'), failure='values', success=False)
+    assert digest(table/'values.txt')==old_values and not (table/'values.txt.tmp').exists()
+    assert any(e[0]=='RENAME' and e[2].endswith('.cfr.zst') for e in events)
+    assert not any(e[0]=='RENAME' and e[2].endswith('values.txt') for e in events)
+    run(score(table,'1:1'))
+
+    # Extension metadata is atomically published and synchronized before any
+    # destination checkpoint, and a failure cannot leave a partial manifest.
+    source_hashes={p.name:digest(p) for p in table.iterdir()}
+    extension = root/'extension'
+    events = run(score(extension,extension=table), failure='extension', success=False)
+    assert not (extension/'extension.txt').exists()
+    assert not (extension/'extension.txt.tmp').exists()
+    assert not list(extension.glob('score-*.cfr.zst'))
+    (extension/'extension.txt.tmp').write_text('incomplete previous attempt')
+    events = run(score(extension,extension=table)); ordered(events)
+    renamed=[pathlib.Path(e[2]).name for e in events if e[0]=='RENAME']
+    assert renamed==['extension.txt','score-02-02.cfr.zst','values.txt'], renamed
+    assert {p.name:digest(p) for p in table.iterdir()}==source_hashes
+
+    # A failed directory synchronization after rename reports an error while
+    # leaving the new complete file visible. It does not promise rollback.
+    events = run(generic(checkpoint,2),failure='directory-after-rename',success=False)
+    assert digest(checkpoint)!=original and checkpoint.exists()
+    assert [e[0] for e in events]==['FILE','RENAME','FAIL'], events
+    assert not list(root.glob('checkpoint.cfr.tmp.*'))
+    run(['--format','single-bet','--load',str(checkpoint),
+         '--export-strategy',str(root/'readback.txt')])
+    assert 'training_iterations=2' in (root/'readback.txt').read_text()
+print('All persistence ordering and failure checks passed.')
