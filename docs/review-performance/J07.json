{
  "item": "J07",
  "parent_commit": "b898c5be12e3abe4b53241c6e6b25e4d0e7a9735",
  "production_change": "Only the private best-response hash finalizer. Persisted keys and every traversal/metric formula remain unchanged.",
  "method": "Three paired runs per workload, alternating order, CPU affinity fixed to logical CPU0. Train10000 iterations with seed7 before timing complete exact evaluation. No own builds or tests run concurrently. Conditional single-bet case uses50 evaluations to lengthen the workload.",
  "scope_note": "first-hand-fixed is a conditional subproblem, not root exploitability. Training counters are not evaluation node counts.",
  "dispersion_before": "mus.heads-up-single-hand/v1 hands=330 initial_buckets=1 insertion_probes=54615 mean=165.5 capacity=1024\nmus.heads-up-single-hand.raises-to-eight/v1 hands=330 initial_buckets=1 insertion_probes=54615 mean=165.5 capacity=1024\n",
  "dispersion_after": "mus.heads-up-single-hand/v1 hands=330 initial_buckets=279 insertion_probes=429 mean=1.3 capacity=1024\nmus.heads-up-single-hand.raises-to-eight/v1 hands=330 initial_buckets=286 insertion_probes=403 mean=1.2 capacity=1024\n",
  "dispersion_probe_source": "#include <stdio.h>\n#include \"/home/pablome/orca/workspaces/mus-solver/mejoras/src/mus_evaluation.c\"\nstatic void check(Status s) { if (s) exit(1); }\nint main(void) {\n    const Game *games[] = {mus_single_bet_game_descriptor(), mus_raises_to_eight_game_descriptor()};\n    for (int f=0; f<2; f++) {\n        const Game *g=games[f]; BestResponseStore store;\n        check(best_store_init(&store)); size_t initial[1024]={0}, total=0, unique=0;\n        for(int a=0;a<8;a++) for(int b=a;b<8;b++) for(int c=b;c<8;c++) for(int d=c;d<8;d++) {\n            uint8_t hand[8]={0};hand[a]++;hand[b]++;hand[c]++;hand[d]++;\n            MusGameState s;check(f == 0 ? mus_single_bet_game_state_init(&s) : mus_raises_to_eight_game_state_init(&s));\n            for(int i=0;i<7;i++)check(cfr_game_apply_action(g,(GameState*)&s,hand[i]));\n            for(int i=0;i<7;i++)check(cfr_game_apply_action(g,(GameState*)&s,0));\n            InfoSetKey key; check(cfr_game_information_set_key(g,(GameState*)&s,&key));\n            size_t slot=hash_key(key)&1023; if(initial[slot]++==0)unique++;\n            size_t probes=1;while(store.entries[slot].occupied){probes++;slot=(slot+1)&1023;}\n            total+=probes;BestResponseEntry *entry;\n            check(best_store_get_or_create(&store,key,0,2,&entry));\n        }\n        printf(\"%s hands=%zu initial_buckets=%zu insertion_probes=%zu mean=%.1f capacity=%zu\\n\",g->strategy_schema_id,store.size,unique,total,(double)total/store.size,store.capacity);\n        best_store_destroy(&store);\n    }\n}\n",
