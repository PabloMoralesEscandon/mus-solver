+"""Distinguish unavailable nodes from trained uniform policies in every TXT route."""
+import json
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+
+bot, builder = sys.argv[1:]
+
+def run(command, queries):
+    p = subprocess.run(command, input='\n'.join(map(json.dumps, queries))+'\n',
+                       capture_output=True, text=True, check=True, timeout=30)
+    assert not p.stderr, p.stderr
+    return [json.loads(line) for line in p.stdout.splitlines()]
+
+def observation(phase, player, score=False):
+    start = [39,39] if score else [10,12]
+    q = dict(player=player, phase=phase, hand=[0]*7+[4],
+             match_scores=start, hand_start_scores=start, hand_scores_complete=True,
+             pending_wager_total=0,
+             previous_strengths=[0]*{'grande':0,'chica':1,'pares':2,'juego':3,'punto':3,'mus':0,'discard':0}[phase],
+             legal_actions=[dict(type='pass'),dict(type='raise',amount=2),dict(type='ordago')])
+    if phase == 'punto': q['hand'] = [4]+[0]*7
+    if phase == 'mus': q['legal_actions'] = [dict(type='mus'),dict(type='no_mus')]
+    elif phase == 'discard':
+        q['legal_actions'] = [dict(type='discard',mask=1),dict(type='discard',mask=15)]
+        q['discard_counts'] = [2,0] if player else [0,0]
+    elif player: q['history'] = [dict(player=0,type='pass')]
+    return q
+
+with tempfile.TemporaryDirectory(prefix='mus-availability-') as temporary:
+    root = Path(temporary)
+    for format in range(3):
+        directory = root/str(format);directory.mkdir()
+        subprocess.run([builder,'--availability-fixture',str(directory),str(format)],
+                       check=True, stdout=subprocess.DEVNULL)
+        score = format == 2
+        phases = ['grande','chica','pares','juego','punto','mus','discard']
+        queries = [observation(phase,player,score) for player in [0,1] for phase in phases]
+        common = ['--seed','123','--no-score-adjustment']
+        if not score:
+            paths = [directory/'policy.cfr', directory/'policy.cfr.zst', directory/'policy.txt']
+        else:
+            # The deployed score selector uses TXT for cells. Exercise the zero
+            # cell with all three backends for its otherwise nonzero generic.
+            paths = [root/'1'/'policy.cfr', root/'1'/'policy.cfr.zst', root/'1'/'policy.txt']
+            common += ['--score-table',str(directory/'values.txt'),'--score-strategies',str(directory)]
+        commands = [[bot,flag,str(path),*common] for flag,path in
+                    zip(['--load','--load-compressed','--strategy'],paths)]
+        expected = run(commands[0],queries)
+        for command in commands[1:]: assert run(command,queries) == expected
+        for q, result in zip(queries,expected):
+            assert result['ok'], (q,result)
+            empty = q['phase'] in ['grande','punto','pares'] or (q['phase'] in ['mus','discard'] and q['player']==0)
+            assert result['diagnostic']['method'] == ('fallback' if empty else 'exact'), (q,result)
+            if score: assert result['diagnostic']['strategy'] == 'ordago-score'
+            if q['phase']=='mus' and q['player']==1:
+                assert [p['probability'] for p in result['probabilities']] == [.5,.5]
+            if empty: assert len(result['probabilities']) == 1 and result['probabilities'][0]['probability']==1
+        path = directory/('score-39-39.txt' if score else 'policy.txt')
+        original = path.read_text()
+        assert 'available=0 ' in original and 'available=1 ' in original
+        assert original.startswith('mus-strategy version=2 ')
+        assert original.splitlines()[-1]=='mus-strategy-end information_sets=12'
+        # Legacy v1 cannot recover availability and keeps its historical uniform.
+        legacy = re.sub(r' available=[01](?= )','',original.rsplit('mus-strategy-end ',1)[0])
+        path.write_text(legacy.replace('version=2','version=1',1))
+        old = run(commands[2],queries)
+        for q,result in zip(queries,old):
+            assert result['ok']
+            assert result['diagnostic']['method']==('fallback' if q['phase']=='pares' else 'exact')
+        path.write_text(original)
+        # Validate availability and probabilities even on a zero-mass queried row.
+        for bad in ['available=2 ', 'available=-1 ', 'available=00 ', 'available= ', 'missing=0 ']:
+            path.write_text(original.replace('available=0 ',bad))
+            result = run(commands[2],[observation('mus',0,score)])[0]
+            assert result['error']=='invalid_checkpoint',result
+        path.write_text(original.replace('mus=0.5','mus=nan'))
+        result = run(commands[2],[observation('mus',0,score)])[0]
+        assert result['error']=='invalid_strategy_data', result
+        path.write_text(original)
+print('All TXT availability checks passed.')
