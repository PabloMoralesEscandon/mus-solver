+    const char *names[] = {"policy.cfr", "policy.cfr.zst", "policy.txt"};
+    for (size_t i = 0; i < 3; ++i) {
+        snprintf(path, sizeof(path), "%s/%s", directory, score && i == 2 ? "score-39-39.txt" : names[i]);
+        FILE *file = fopen(path, "wb"); CHECK(file != NULL);
+        if (file) {
+            OK(i == 0 ? cfr_checkpoint_write(file, &trainer)
+                : i == 1 ? cfr_checkpoint_write_zstd(file, &trainer)
+                : score ? mus_score_strategy_write_text(file, &trainer)
+                : public_format ? mus_ordago_public_strategy_write_text(file, &trainer)
+                                : mus_ordago_strategy_write_text(file, &trainer));
+            CHECK(fclose(file) == 0);
+        }
+    }
+    if (score) {
+        snprintf(path, sizeof(path), "%s/values.txt", directory);
+        FILE *file = fopen(path, "wb"); CHECK(file != NULL);
+        if (file) { OK(mus_score_table_write(file, &table)); CHECK(fclose(file) == 0); }
+    }
+    OK(cfr_info_store_destroy(&store));
+}
