+/* A bounded completion marker detects missing suffixes, including whole rows.
+ * It does not certify arbitrary edits within an otherwise complete file. */
+static Status read_footer(FILE *stream, off_t size, off_t first_row,
+                           size_t expected_count, off_t *rows_end) {
+    char tail[129];
+    const off_t remaining = size - first_row;
+    if (remaining <= 0) return CFR_STATUS_FORMAT_ERROR;
+    const size_t length = remaining < 128 ? (size_t)remaining : 128;
+    Status status = seek_file(stream, size - (off_t)length);
+    if (status != CFR_STATUS_SUCCESS) return status;
+    if (fread(tail, 1, length, stream) != length)
+        return ferror(stream) ? CFR_STATUS_IO_ERROR : CFR_STATUS_FORMAT_ERROR;
+    if (memchr(tail, '\0', length) || tail[length - 1] != '\n')
+        return CFR_STATUS_FORMAT_ERROR;
+    tail[length] = '\0';
+    size_t start = length - 1;
+    while (start > 0 && tail[start - 1] != '\n') start--;
+    if (start == 0 && size - (off_t)length != first_row)
+        return CFR_STATUS_FORMAT_ERROR;
+    const char *cursor = tail + start;
+    size_t count;
+    status = header_size(&cursor, "mus-strategy-end information_sets=", '\n', &count);
+    if (status != CFR_STATUS_SUCCESS || *cursor != '\0' || count != expected_count)
+        return CFR_STATUS_FORMAT_ERROR;
+    *rows_end = size - (off_t)(length - start);
+    return CFR_STATUS_SUCCESS;
+}
