+ * training randomness is needed to distinguish the four cases. */
+static void write_availability_fixture(const char *directory, int format) {
+    const bool score = format == 2, public_format = format == 1;
+    MusScoreTable table;
+    MusScoreGame score_game;
+    MusGameState state;
+    const Game *game = public_format ? mus_ordago_public_game_descriptor()
+                                    : mus_ordago_game_descriptor();
+    if (score) {
+        OK(mus_score_table_init_region(&table, 40, 39, 39));
+        table.cells[39][39] = (MusScoreCell){.ready = true, .value = 0,
+            .iterations = 1, .evaluation_samples = 1, .training_seed = 7};
+        OK(mus_score_game_init(&score_game, &table, 39, 39));
+        game = &score_game.game;
+        OK(mus_score_game_state_init(&state, &score_game));
+    } else {
+        OK(public_format ? mus_ordago_public_game_state_init(&state)
+                         : mus_ordago_game_state_init(&state));
+    }
+    InfoStore store = {0}; OK(cfr_info_store_init(&store));
+    for (int p = 0; p < 2; ++p) {
+        const MusGamePhase phases[] = {MUS_PHASE_GRANDE, MUS_PHASE_CHICA,
+            MUS_PHASE_JUEGO, MUS_PHASE_PUNTO,
+            p == 0 ? MUS_PHASE_MUS_PLAYER_0 : MUS_PHASE_MUS_PLAYER_1,
+            p == 0 ? MUS_PHASE_DISCARD_PLAYER_0 : MUS_PHASE_DISCARD_PLAYER_1};
+        for (size_t i = 0; i < sizeof(phases) / sizeof(*phases); ++i) {
+            MusOrdagoInformationSet info = info_base(phases[i], (Player)p);
+            if (phases[i] >= MUS_PHASE_GRANDE && phases[i] <= MUS_PHASE_PUNTO)
+                info.bet_stage = p == 0 ? MUS_BET_FIRST_TO_ACT : MUS_BET_SECOND_AFTER_PASS;
+            if (phases[i] == MUS_PHASE_DISCARD_PLAYER_1) info.discard_counts[0][0] = 2;
+            if (score) info = score_info(info, 39, 39);
+            InfoSetKey key = put_format(&store, info, public_format, MUS_ACTION_PASS, .25, MUS_ACTION_ORDAGO);
+            InfoNode *node = NULL; OK(cfr_info_store_find(&store, key, &node));
+            const bool zero = i == 0 || i == 3 || (i >= 4 && p == 0);
+            if (node && i != 2)
+                for (size_t a = 0; a < node->action_count; ++a) node->strategy_sums[a] = zero ? 0 : 1;
+        }
+    }
+    Trainer trainer;
+    OK(cfr_trainer_init_mccfr(&trainer, game, mus_game_state_as_game_state(&state), &store, 7));
+    trainer.training_iterations = 1;
