    "runner_source": "import json, os, tempfile, time\nfrom pathlib import Path\nruns=[]\nfor game,iterations in [('single-bet',100000),('raises-to-eight',30000),('ordago',500)]:\n    for repeat in range(3):\n        for label in (['j05','j15'] if repeat%2==0 else ['j15','j05']):\n            command=[f'build/review-{label}/release/mus-solver','--format',game,'--iterations',str(iterations),'--seed','7','--threads','1']\n            with tempfile.TemporaryFile(mode='w+') as output:\n                start=time.perf_counter()\n                pid=os.posix_spawn(command[0],command,os.environ,file_actions=[(os.POSIX_SPAWN_DUP2,output.fileno(),1)])\n                _,status,usage=os.wait4(pid,0)\n                if status: raise RuntimeError(status)\n                elapsed=time.perf_counter()-start\n                output.seek(0)\n                row={'format':game,'variant':label,'repeat':repeat+1,'seconds':elapsed,'peak_rss_kib':usage.ru_maxrss,'command':command,'stdout':output.read()}\n            runs.append(row)\n            Path('/tmp/mus-review-j15-generic.json').write_text(json.dumps(runs,indent=2)+'\\n')\n            print(json.dumps(row),flush=True)\n"
  },
